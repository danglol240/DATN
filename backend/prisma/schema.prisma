generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id            String    @id @default(uuid())
  hostname      String
  ip            String
  url           String?
  os            String?
  status        String    @default("online")
  lastHeartbeat DateTime  @default(now())
  cpuPercent    Float?
  memPercent    Float?
  rulesConfig   String    @default("{}")
  iptablesRules String?
  interfaces    String?
  alerts        Alert[]
  events        Event[]
  commands      Command[]
}

model Event {
  id        String   @id @default(uuid())
  agentId   String
  type      String
  data      String
  timestamp DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])
}

model Alert {
  id          String   @id @default(uuid())
  agentId     String
  severity    String
  ruleName    String
  description String
  resolved    Boolean  @default(false)
  timestamp   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id])
}

model Command {
  id         String    @id @default(uuid())
  agentId    String
  action     String
  params     String    @default("{}")
  status     String    @default("pending")
  result     String?
  createdAt  DateTime  @default(now())
  doneAt     DateTime?
  batchJobId String?
  agent      Agent     @relation(fields: [agentId], references: [id])
}

model BatchJob {
  id               String   @id @default(uuid())
  action           String
  params           String   @default("{}")
  totalAgents      Int
  successfulAgents String[]
  failedAgents     String[]
  retryCount       Int      @default(0)
  maxRetries       Int      @default(3)
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  password            String
  role                String               @default("viewer")
  twoFactorSecret     String?
  twoFactorEnabled    Boolean              @default(false)
  createdAt           DateTime             @default(now())
  enrollmentCodes     EnrollmentCode[]
  enrollmentReviews   EnrollmentRequest[]
}

model EnrollmentCode {
  code            String    @id
  createdBy       String
  creator         User      @relation(fields: [createdBy], references: [id])
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  used            Boolean   @default(false)
  usedAt          DateTime?
  usedByHostname  String?
}

// Yêu cầu enrollment — chờ admin duyệt thủ công trước khi ký cert.
// status: pending → approved | rejected → delivered (sau khi agent lấy cert)
model EnrollmentRequest {
  id           String    @id @default(uuid())
  hostname     String?
  agentIp      String
  csr          String    @db.Text
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewer     User?     @relation(fields: [reviewedBy], references: [id])
  cert         String?   @db.Text  // bị xóa sau khi agent lấy (one-time)
}
